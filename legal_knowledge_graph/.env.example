# Sao chép thành .env rồi điền mật khẩu thật.
# cp legal_knowledge_graph/.env.example legal_knowledge_graph/.env
# (PowerShell: Copy-Item legal_knowledge_graph/.env.example legal_knowledge_graph/.env)
#
# QUAN TRỌNG: đây là container Neo4j THỨ HAI, port khác hoàn toàn với
# Neo4j của pipeline tự động (src/vanban, mặc định bolt://localhost:7687).
# Xem legal_knowledge_graph/docker-compose.yml.

LKG_NEO4J_URI=bolt://localhost:7688
LKG_NEO4J_USER=neo4j
LKG_NEO4J_PASSWORD=lkg12345678
LKG_NEO4J_DATABASE=neo4j
