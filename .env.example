# Sao chép file này thành `.env` rồi điền giá trị thật.
# cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ============================================================
# GEMMA / GEMINI — bắt buộc cho bước hiệu đính (`python run.py fix`)
# Lấy key tại https://aistudio.google.com/apikey
# ============================================================
# Khai báo BAO NHIÊU KEY CŨNG ĐƯỢC — pipeline xoay tua qua tất cả, key nào
# chạm giới hạn thì cho nghỉ và chuyển ngay sang key khác. Key trùng nhau bị
# tự loại. Đánh số tuỳ ý, không cần liên tục:
GEMINI_API_KEY_0=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Cách cũ (một key) vẫn chạy được, và gộp chung với các key đánh số ở trên:
# GEMINI_API_KEY=

# Hoặc nhét hết vào một dòng, ngăn bằng dấu phẩy:
# GEMINI_API_KEYS=key1,key2,key3

# Gemma gọi qua chính Gemini API, cùng một key.
# Xem key của bạn gọi được model nào:  python run.py models
GEMINI_MODEL=gemma-4-31b-it

# Số luồng gọi song song.
# ĐỂ TRỐNG = tự co giãn theo số key (3 luồng/key, trần 16). Free tier tính
# hạn mức TRÊN TỪNG KEY nên càng nhiều key càng chạy được nhiều luồng.
# GEMINI_WORKERS=4

# Số request bay CÙNG LÚC trên MỘT key. Chặn ở đây rẻ hơn để nó bắn 429 rồi
# mới lùi: vượt trần là mất cả lượt gọi lẫn thời gian cooldown.
GEMINI_MAX_INFLIGHT_PER_KEY=2

# Key dính 429 thì nghỉ bao lâu (giây) rồi mới được gọi lại. Nếu API gửi kèm
# retryDelay thì lấy theo API, hai mốc này là cận dưới/trên.
GEMINI_KEY_COOLDOWN=45
GEMINI_KEY_COOLDOWN_MAX=900

# Hết quota NGÀY thì nghỉ hẳn chừng này giây (thử lại sớm chỉ tốn công).
GEMINI_KEY_COOLDOWN_DAILY=3600

# Số ký tự mỗi khối gửi lên model (văn bản dài sẽ bị cắt nhỏ).
GEMINI_CHUNK_CHARS=7000

# Riêng Gemma: hạn mức output nhỏ hơn Gemini nên tự hạ trần khối xuống mức này.
GEMMA_CHUNK_CHARS=4500

# Tắt reasoning. ĐỪNG BẬT: Gemma 4 bật thinking sẽ tiêu hết hạn mức output vào
# phần suy nghĩ (đo được 32.765 token) rồi trả về RỖNG.
# Hai họ model dùng hai tham số khác nhau, pipeline tự chọn đúng cái:
#   Gemma  -> thinking_level   |   Gemini -> thinking_budget
GEMINI_THINKING_BUDGET=0
GEMMA_THINKING_LEVEL=minimal

# Trần output mỗi khối, nới rộng cho khỏi cụt giữa chừng.
GEMINI_MAX_OUTPUT_TOKENS=16000

# ============================================================
# OCR — chọn engine
# ============================================================
# local = EasyOCR chạy tại máy: miễn phí, không giới hạn, và đo được là
#         nhận dấu tiếng Việt CHÍNH XÁC HƠN api (xem README mục 5).
# api   = gọi API OCR: nhanh hơn nhưng tính credit theo TRANG.
OCR_ENGINE=local

# Tiếng Việt. Muốn kèm tiếng Anh: vi,en
LOCAL_OCR_LANGS=vi

# 150 DPI — đo thực tế 120..300 DPI độ chính xác gần như không đổi,
# nhưng 300 DPI chậm hơn 2,3 lần.
LOCAL_OCR_DPI=150

# 4 tiến trình x 3 luồng torch = 431 trang/giờ trên CPU 12 nhân.
# Thêm tiến trình KHÔNG nhanh hơn (torch đã ăn hết nhân).
LOCAL_OCR_WORKERS=4
LOCAL_OCR_THREADS=3

# Bật khi chạy trên máy có GPU (Colab...). Pipeline tự hạ về 1 tiến trình.
# EasyOCR trên T4 nhanh hơn CPU khoảng 4 lần — chỉ đáng nếu bạn ngại chiếm máy.
LOCAL_OCR_GPU=false

# ============================================================
# OCR API (chỉ dùng khi OCR_ENGINE=api)
# ============================================================
OCR_BASE_URL=http://104.37.191.24:7600
OCR_LANGUAGES=vie

# API upstream xoay vòng key, thỉnh thoảng trả 500 -> cần retry.
OCR_MAX_ATTEMPTS=5
OCR_WORKERS=3

# Dừng OCR khi credit còn dưới mức này. Session nhớ chỗ đang dở -> nạp thêm
# credit rồi chạy lại `python run.py ocr` là đi tiếp. Đặt 0 để chạy đến cạn.
OCR_MIN_CREDITS=100

# true = giữ lại file PDF đã OCR trong data/interim/ocr_pdf (rất tốn ổ cứng).
OCR_KEEP_PDF=false

# ============================================================
# KHÁC
# ============================================================
SESSION_NAME=default

# ============================================================
# LEGAL_KNOWLEDGE_GRAPH (`python run.py lkg ...`) — đồ thị gán tay,
# xem src/legal_knowledge_graph/README.md. Biến tiền tố LKG_ để không
# đụng các biến NEO4J_*/GEMINI_* ở trên: instance Neo4j RIÊNG (cổng
# 7688, không phải 7687 của pipeline tự động).
# ============================================================
LKG_NEO4J_URI=bolt://localhost:7688
LKG_NEO4J_USER=neo4j
LKG_NEO4J_PASSWORD=lkg12345678
LKG_NEO4J_DATABASE=neo4j

# --- LLM của chatbot: đổi nhà cung cấp chỉ bằng các biến dưới đây ---
#   gemini             Gemini Developer API, bể nhiều key xoay vòng (mặc định)
#   openai_compatible  mọi server chuẩn OpenAI API: tự host (vLLM, Ollama, TGI,
#                      LM Studio...) hoặc dịch vụ (OpenAI, OpenRouter, Together, Groq...)
LKG_LLM_PROVIDER=gemini
LKG_LLM_MODEL=gemini-3.6-flash

# Gemini: key gộp chung bể với GEMINI_API_KEY_*/GEMMA_API_KEY_* đã điền ở trên
# (không bắt buộc điền lại ở đây), xem core/config.py::gemini_keys().
LKG_GEMINI_API_KEY_0=

# openai_compatible: địa chỉ server + key (server tự host không kiểm key thì để trống).
#   vLLM tự host  : LKG_LLM_BASE_URL=http://<host>:8000/v1   LKG_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
#   Ollama        : LKG_LLM_BASE_URL=http://<host>:11434/v1  LKG_LLM_MODEL=qwen2.5:14b
#   OpenRouter    : LKG_LLM_BASE_URL=https://openrouter.ai/api/v1  LKG_LLM_API_KEY=sk-or-...
LKG_LLM_BASE_URL=
LKG_LLM_API_KEY=
# Cách ép output có cấu trúc: json_schema (mặc định) | function_calling | json_mode.
# Server chưa hỗ trợ response_format JSON Schema thì dùng function_calling.
LKG_LLM_STRUCTURED_METHOD=json_schema
# Trần cho MỘT request — một lần 504 ăn trọn thời gian này.
LKG_LLM_TIMEOUT_SECONDS=30
LKG_LLM_MAX_RETRIES=2
# Model dự phòng khi model chính báo 503 quá tải (chỉ gemini); trống = tắt.
#   ví dụ: LKG_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LKG_LLM_FALLBACK_MODEL=
# Trần thời gian cho CẢ một lượt hỏi (giây), mọi lời gọi Gemini dùng chung; 0 = không giới hạn.
LKG_TURN_DEADLINE_SECONDS=60

# Origin được gọi chat API, phân tách bằng dấu phẩy — thêm domain giao diện khi deploy.
LKG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Số dòng tối đa cho mọi truy vấn Cypher của chatbot (template lẫn agent).
LKG_NLQ_ROW_CAP=200

# Timeout Cypher phía server (giây).
LKG_NLQ_QUERY_TIMEOUT_SECONDS=10

# Số lượt tối đa chatbot hỏi lại một tham số thiếu/mơ hồ trước khi chuyển
# sang agent tự tra cứu.
LKG_NLQ_MAX_CLARIFY_ROUNDS=2

# Chatbot LangGraph (core/chat/): số tin nhắn gần nhất dùng để hiểu câu hỏi
# nối tiếp; số vòng tối đa của agent; số dòng đưa vào prompt trả lời;
# độ dài tối đa câu hỏi.
LKG_CHAT_HISTORY_WINDOW=6
LKG_AGENT_MAX_STEPS=4
LKG_ANSWER_MAX_ROWS=30
LKG_CHAT_MAX_QUESTION_CHARS=1000

# Log cục bộ có cấu trúc (JSON, logs/chat.log). DEBUG ghi thêm Cypher đầy
# đủ, params, dòng kết quả mẫu, traceback.
LKG_LOG_LEVEL=INFO
# Log theo phiên hội thoại: mỗi thread_id một file văn bản trong
# logs/sessions/<ngày>/, ghi đầu vào / đầu ra từng bước của mỗi lượt (prompt
# LLM, Cypher, dòng kết quả, Điều GraphRAG, tool agent, lỗi) — để debug.
LKG_SESSION_LOG=true
# LKG_SESSION_LOG_DIR=        # mặc định logs/sessions

# LangSmith tracing — bật khi điền LANGSMITH_API_KEY. Khi bật, câu hỏi,
# Cypher và dòng kết quả được gửi lên LangSmith cloud (KHÔNG gửi API key).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pbl6-legal-chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# Embedding Article cho GraphRAG — xem core/llm/embeddings.py,
# core/graph_query/article_embeddings.py. Backfill chạy tay: python run.py lkg embed-articles
# ============================================================

# Provider chọn độc lập với LLM: gemini (mặc định) | openai_compatible.
# ĐỔI MODEL HOẶC SỐ CHIỀU: đặt LKG_EMBED_DIMENSIONS đúng số chiều model trả về,
# rồi chạy `python run.py lkg embed-articles --reset` (xoá embedding cũ, dựng lại
# vector index, embed lại toàn bộ 8.814 Điều).
LKG_EMBED_PROVIDER=gemini
LKG_EMBED_MODEL=gemini-embedding-001
LKG_EMBED_DIMENSIONS=768
# openai_compatible: để trống thì dùng chung LKG_LLM_BASE_URL / LKG_LLM_API_KEY.
#   ví dụ TEI/vLLM tự host BAAI/bge-m3: LKG_EMBED_MODEL=BAAI/bge-m3  LKG_EMBED_DIMENSIONS=1024
LKG_EMBED_BASE_URL=
LKG_EMBED_API_KEY=

# Số Article đọc mỗi lượt round-trip Neo4j (article_embeddings.py).
LKG_EMBED_READ_BATCH_SIZE=200
# Số text gộp vào 1 lần gọi embed_content() — giảm số request thật gửi đi.
LKG_EMBED_API_BATCH_SIZE=32

LKG_VECTOR_INDEX_NAME=article_embedding

# GraphRAG (core/graph_query/graph_context.py, core/chat/retrieval/graph_rag.py).
# Số Điều hạt giống giữ lại sau khi gộp vector + fulltext (RRF), và số ứng viên mỗi nguồn.
LKG_RETRIEVAL_TOP_K=5
LKG_GRAPH_RAG_SEED_K=8
# Số văn bản từ kết quả template được lấy thêm Điều bên trong, và số Điều mỗi văn bản.
LKG_GRAPH_RAG_SCOPE_DOCS=5
LKG_GRAPH_RAG_SCOPE_PER_DOC=2
# Số văn bản liên quan tối đa mỗi loại quan hệ (thay thế, bãi bỏ, sửa đổi, căn cứ).
LKG_GRAPH_RAG_MAX_RELATED=3
# Ngân sách ký tự toàn văn Điều đưa vào prompt, và mức cắt mỗi Điều.
LKG_GRAPH_RAG_CONTEXT_CHARS=12000
LKG_GRAPH_RAG_ARTICLE_CHARS=1500

# Tắt được để chat-eval/test thường ngày không tốn gấp đôi quota Gemini —
# chat UI thật vẫn nên để mặc định bật (true).
LKG_RETRIEVAL_ENABLED=true
